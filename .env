# Synaptia — Environment Variables
# Copy this file to .env and fill in your values

# Tier 1 — OpenRouter (primary AI provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Tier 2 — Google Gemini (fallback)
GEMINI_API_KEY=AIzaSyDCFDc7rMedBJ5nWpII7SEgOZEpHzVlLDU

# Tier 3 — Local Ollama (last resort, leave as-is for local dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Flask Configuration
FLASK_ENV=production
DEBUG=False
SECRET_KEY=synaptia-secret-key-change-in-production

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5002
